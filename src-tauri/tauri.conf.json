{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Album Builder",
  "version": "0.2.2",
  "identifier": "com.patrickcarroll.album-builder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Album Builder",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
